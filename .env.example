# ─────────────────────────────────────────────────────────────────────────────
# StockSnap environment variables — TEMPLATE (safe to commit; no real secrets).
#
# To run the app:
#   1. Copy this file to ".env.local"   (cp .env.example .env.local)
#   2. Also copy it to ".env"           (cp .env.example .env)   ← Prisma reads this
#   3. Fill in the values below.
# Your real .env / .env.local are git-ignored, so your secrets never get uploaded.
# ─────────────────────────────────────────────────────────────────────────────

# Local SQLite database file (used by Prisma). This default is fine as-is.
DATABASE_URL="file:./dev.db"

# Google Gemini API key — reads the handwritten notes.
# Get a free one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Twilio (only needed for the WhatsApp feature). From https://console.twilio.com
# Used to download the photo a vendor sends on WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
