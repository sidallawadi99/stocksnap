// This is your Prisma schema file.
// It describes the tables (called "models") in our database.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A kirana store = one tenant. Each store has its own catalogue, stock and
/// deliveries, and one owner login. (Passwords are plain text — PROTOTYPE ONLY.)
model Store {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  createdAt DateTime @default(now())

  products   Product[]
  deliveries Delivery[]
}

/// The catalogue. One row per product a store stocks.
model Product {
  id            Int      @id @default(autoincrement())
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId       Int
  name          String
  brand         String?  // e.g. "Amul", "Aashirvaad"
  category      String?  // e.g. "Dairy", "Bakery", "Staples"
  unit          String   @default("packet") // the base unit we count stock in
  unitsPerCrate Int      @default(1)         // how many base units make 1 crate (e.g. 30)
  stock         Int      @default(0)         // current quantity in stock, in base units
  aliases       String?  // comma-separated alternate names, helps the AI match messy handwriting
  // "local_vendor" = arrives daily on handwritten slips (our app updates these).
  // "distributor"  = bought via formal invoices/POs (shown for completeness).
  supply        String   @default("distributor")
  shelfLifeDays Int?     // how many days the item stays fresh (null = non-perishable)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines   DeliveryLine[]
  batches Batch[]

  @@unique([storeId, name]) // names are unique within a store, not globally
}

/// A single received lot of a perishable product, with its own expiry.
/// One batch is created per confirmed delivery line. This lets us answer
/// "how many units expire today?" and "how many were added today?".
model Batch {
  id         Int       @id @default(autoincrement())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  Int
  quantity   Int
  receivedAt DateTime  @default(now())
  expiresAt  DateTime
  // Which delivery created this batch (null for the initial seeded stock).
  // Lets us reverse a delivery's stock when it's edited or deleted.
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  deliveryId Int?
}

/// One delivery note received from a vendor (via upload or WhatsApp).
model Delivery {
  id         Int      @id @default(autoincrement())
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId    Int
  vendorName String?
  source     String   @default("upload") // "upload" or "whatsapp"
  sourceRef  String?  // e.g. WhatsApp sender id, so a "CONFIRM" reply finds this delivery
  imagePath  String?  // where the photo is stored
  status      String   @default("pending") // "pending" -> "confirmed"
  createdAt   DateTime @default(now())
  confirmedAt DateTime? // set when the owner confirms and stock is applied

  lines   DeliveryLine[]
  batches Batch[]
}

/// One line item the AI extracted from a delivery note.
model DeliveryLine {
  id         Int      @id @default(autoincrement())
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId Int

  rawText    String  // the full line as the AI read it, e.g. "Toned Milk 1 crate"
  rawName    String  // just the item name the AI parsed, e.g. "Toned Milk"
  quantity   Float   // the number the AI parsed, e.g. 1
  rawUnit    String? // the unit the AI parsed, e.g. "crate" or "packet"

  product     Product? @relation(fields: [productId], references: [id])
  productId   Int?     // the catalogue product we matched it to (null if no match)
  resolvedQty Int      @default(0)        // quantity converted into the product's base unit
  confidence  Float?                      // how confident the AI was, 0 to 1
  status      String   @default("matched") // "matched", "unmatched", or "confirmed"

  // For the accuracy metric: the AI's ORIGINAL guess, and whether the owner
  // changed it on review. "edited = false" on confirm means the AI got it right.
  aiProductId   Int?
  aiResolvedQty Int     @default(0)
  edited        Boolean @default(false)
}
